def fetch_mubu_data():
    with sync_playwright() as p:
        has_auth = os.path.exists(AUTH_FILE)
        # 核心优化：采用无头模式并锁定 msedge 通道，完美适配合盖后台运行，绝不报错
        browser = p.chromium.launch(headless=True, channel="msedge")
        context = browser.new_context(storage_state=AUTH_FILE if has_auth else None)
        page = context.new_page()

        if not has_auth:
            page.goto("https://mubu.com/login")
            print("【重要】请扫码登录...")
            time.sleep(35)
            context.storage_state(path=AUTH_FILE)
            browser.close()
            return None

        page.goto("https://mubu.com/app/folders/recent")
        time.sleep(6)

        sidebar_text = ""
        for div in page.locator("div").all():
            try:
                text = div.inner_text()
                if "今日速记" in text and "最近编辑" in text and "快速访问" in text:
                    if not sidebar_text or len(text) < len(sidebar_text):
                        sidebar_text = text
            except Exception:
                continue

        if not sidebar_text:
            sidebar_text = page.locator("body").inner_text()

        lines = [line.strip() for line in sidebar_text.split("\n") if line.strip()]

        today = datetime.date.today()
        stop_date = today - datetime.timedelta(days=4)
        stop_signals = [
            f"{stop_date.month}.{stop_date.day}",
            f"{stop_date.month}月{stop_date.day}日",
            stop_date.strftime("%m-%d")
        ]
        print(f"📅 今日日期: {today.month}.{today.day} | 扫描到以下边界将自动停止: {stop_signals}")

        target_files = []
        start_collecting = False
        for line in lines:
            if line == "最近编辑":
                start_collecting = True
                continue
            if start_collecting:
                if line == "快速访问":
                    break
                if line in ["今日速记", "我的文档", "教育特惠", "立即认证", "教育特惠买一赠一"]:
                    continue

                if line in stop_signals:
                    print(f"🛑 已触发时间边界线 [{line}]，停止向下收集（不抓取该文件）。")
                    break

                if line not in target_files:
                    target_files.append(line)

        print(f" 成功动态锁定前四天文件列表: {target_files}")

        all_notes_text = ""
        for file_name in target_files:
            try:
                page.goto("https://mubu.com/app/folders/recent")
                time.sleep(4)

                file_element = page.get_by_text(file_name, exact=True).first
                if file_element.is_visible():
                    print(f"👉 正在自动点击打开: {file_name}")
                    file_element.click()
                    time.sleep(5)

                    doc_content = page.locator("body").inner_text()
                    all_notes_text += f"\n\n--- 文档: {file_name} ---\n{doc_content}"
                    print(f" 成功抓取 [{file_name}] 的全部笔记内容")
            except Exception as e:
                print(f" 抓取 {file_name} 失败，自动跳过: {e}")
                continue

        browser.close()
        return all_notes_text


def ai_clean(text):
    client = OpenAI(api_key=DEEPSEEK_API_KEY, base_url="https://api.deepseek.com")
    response = client.chat.completions.create(
        model="deepseek-chat",
        messages=[
            {"role": "system",
             "content": (
                 "你温柔体贴活泼有趣，用第二人称，像哥哥看弟弟的日记一样，给我写一封信"
                 "请帮我剔除网页菜单、按钮等系统垃圾信息，提取有效笔记内容，并按照以下格式整理输出：\n\n"
                 "核心格式要求：\n"
                 "1. 输出内容必须严格且仅分为以下三个部分，标题必须用【】括起来：\n"
                 "【开心的事】\n"
                 "【收获，思考和灵感】\n"
                 "【不足之处】\n"
                 "2. 分条回答，长度根据实际内容决定。在结尾给我说一两句你想跟我说的话\n"
                 "3. 全文绝对不能包含任何粗体字（严禁使用 ** 标记）。"
             )},
            {"role": "user", "content": text[:30000]}
        ]
    )
    return response.choices[0].message.content


def send_mail(body):
    qq_context = ssl.create_default_context()
    qq_context.maximum_version = ssl.TLSVersion.TLSv1_2

    gm_email = "yjin31353@gmail.com"
    recipients = [MY_EMAIL, gm_email]

    today = datetime.date.today()
    mail_title = f"【早啊小羽】{today.month}.{today.day}要开心哦"

    msg = MIMEText(body, 'plain', 'utf-8')
    msg['From'] = MY_EMAIL
    msg['To'] = f"{MY_EMAIL}, {gm_email}"
    msg['Subject'] = Header(mail_title, 'utf-8')

    for attempt in range(1, 4):
        try:
            with smtplib.SMTP_SSL("smtp.qq.com", 465, context=qq_context) as server:
                server.login(MY_EMAIL, SMTP_PASSWORD)
                server.sendmail(MY_EMAIL, recipients, msg.as_string())
            print("【成功】邮件投递成功！")
            return
        except Exception as e:
            print(f"\n⚠️ 第 {attempt} 次投递失败: {e}")
            if attempt < 3:
                time.sleep(6)
    print("【失败】连续 3 次投递均发生错误，请检查当前网络连接。")


